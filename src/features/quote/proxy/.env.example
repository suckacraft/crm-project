# Copy to .env (or export in your shell) before running the proxy.
# The proxy holds these so the browser never sees a provider key.

# Anthropic (Claude Haiku is the default model)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o-mini is the default model)
OPENAI_API_KEY=sk-...

# Optional: override the local dev port (default 8787)
# PORT=8787

# ── Production hardening (all optional; unset = open, for local dev) ─────────
# Require Authorization: Bearer <token> (or x-api-token) on every /api request.
# Set the same value in the app's Settings → API token.
# API_TOKEN=choose-a-long-random-secret
# Lock CORS to your app's origin instead of "*"
# ALLOWED_ORIGIN=https://app.example.com
# Max request body in bytes (default 4000000)
# MAX_BODY_BYTES=4000000

# ── Durable corpus backend ──────────────────────────────────────────────────
# Where the feedback/eval corpus is stored. Defaults to local JSONL files.
# For production, use a managed Postgres so the data lives off GitHub and
# survives any product change:
# CORPUS_BACKEND=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=require            # set to "disable" only for a local, non-TLS Postgres

# Local file backend (default): where JSONL is written
# DATA_DIR=./data

